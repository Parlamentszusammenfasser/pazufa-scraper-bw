# PaZuFa backend base URL (staging)
LTZF_API_URL=https://staging.api.pazufa.de

# PaZuFa backend API key
LTZF_API_KEY=ltzf_...

# LLM provider API key (e.g. OpenAI)
LLM_PROVIDER_KEY=sk-...

# Managed Redis with TLS + auth (Upstash). Takes precedence over REDIS_HOST/PORT.
REDIS_URL=rediss://default:<token>@<endpoint>.upstash.io:6379

# Mattermost webhook for run summaries. Unset = notifications off.
MATTERMOST_HOOK=https://chat.example.org/hooks/...

# Labels the run summaries. Falls back to the config filename, then "local".
ENVIRONMENT=staging

# Override [bawue] / [beteiligung] config values without a per-environment TOML.
# Unset = whatever config.toml says.
WAHLPERIODE=18
WAHLPERIODE_START_DATE=2026-05-01
PARLIS_REQUEST_DELAY_S=0.8
BETEILIGUNG_WAHLPERIODE=18
